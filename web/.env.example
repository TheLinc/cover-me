NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_KEY=eyJ...              # Settings → API → service_role secret (never expose client-side)

STRIPE_SECRET_KEY=sk_test_...            # Developers → API keys (use sk_test_ for local dev)
STRIPE_WEBHOOK_SECRET=whsec_...          # Local dev: from `stripe listen` output; prod: Stripe Dashboard → Webhooks
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRO_PRICE_ID=price_...            # Stripe Dashboard → Products → Cover Me Pro → price ID

NEXT_PUBLIC_SITE_URL=http://localhost:3000  # Change to your production URL on Vercel
