{
  "name": "cover-me-extension",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode localdb",
    "build:local": "node ../scripts/check-prompt-sync.mjs && vite build --mode localdb && node scripts/check-dist.mjs",
    "build": "node ../scripts/check-prompt-sync.mjs && vite build && node scripts/check-dist.mjs",
    "preview": "vite preview",
    "eval": "tsx --env-file-if-exists=.env --env-file-if-exists=eval/.env eval/run.ts",
    "check:prompts": "node ../scripts/check-prompt-sync.mjs",
    "test": "vitest run",
    "test:scrapers-live": "vitest run --mode smoke src/content/scrapers",
    "fixtures:save": "tsx scripts/scraper-fixtures.ts"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "mammoth": "^1.8.0",
    "pdfjs-dist": "^4.9.155",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.4.0",
    "@types/chrome": "^0.0.290",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/webextension-polyfill": "^0.10.7",
    "@vitejs/plugin-react": "^4.3.4",
    "happy-dom": "^20.14.5",
    "playwright": "^1.64.0",
    "tsx": "^4.22.5",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
