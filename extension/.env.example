# Supabase project credentials
# Find these at: https://supabase.com/dashboard → your project → Settings → API
# These are PUBLIC values (publishable key) — safe to bundle in the extension.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# For the hosted tier Edge Functions, also set these in Supabase Dashboard → Edge Functions → Secrets:
ANTHROPIC_API_KEY=sk-ant-...
ENCRYPTION_KEY=<64-char hex string — generate with: openssl rand -hex 32>
SERVICE_KEY=<your secret key from Supabase Dashboard → Settings → API>

VITE_WEB_URL=http://localhost:3000