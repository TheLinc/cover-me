# Supabase project credentials
# Find these at: https://supabase.com/dashboard → your project → Settings → API
# These are PUBLIC values (publishable key) — safe to bundle in the extension.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

VITE_WEB_URL=http://localhost:3100

# 1 shows "Continue with Google". Only after the Google provider is set up (README, self-hosting step 10).
VITE_GOOGLE_SIGNIN=