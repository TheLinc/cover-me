{
  "manifest_version": 3,
  "name": "Cover Me: AI Resume Tailor & Cover Letter Generator",
  "version": "1.3.0",
  "description": "Tailor your resume to any job posting and write a matching cover letter in one click. See your ATS score and missing keywords.",
  "icons": {
    "16": "src/public/icon/16.png",
    "32": "src/public/icon/32.png",
    "48": "src/public/icon/48.png",
    "128": "src/public/icon/128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Cover Me",
    "default_icon": {
      "16": "src/public/icon/16.png",
      "32": "src/public/icon/32.png",
      "48": "src/public/icon/48.png",
      "128": "src/public/icon/128.png"
    }
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "identity"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://ncnmkxzrygnwjiciyxqs.supabase.co/*",
    "https://*.greenhouse.io/*",
    "https://*.lever.co/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.ashbyhq.com/*",
    "https://*.bamboohr.com/*",
    "https://*.workable.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self'; font-src 'self'"
  }
}
