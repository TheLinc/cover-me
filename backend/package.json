{
  "name": "cover-me-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "supabase start",
    "stop": "supabase stop",
    "status": "supabase status",
    "env:local": "node scripts/local-env.mjs",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "functions:serve": "supabase functions serve --env-file supabase/functions/.env",
    "test:functions": "node scripts/test-functions.mjs",
    "lint": "cd supabase/functions && deno lint && deno check */index.ts",
    "test": "node ../scripts/sync-scrapers.mjs --check && node scripts/ensure-stack.mjs && supabase db reset && supabase test db && node scripts/test-functions.mjs",
    "deploy:prod": "node scripts/deploy.mjs",
    "trial-links": "node scripts/trial-links.mjs",
    "notify-site": "node scripts/notify-site.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.117.1",
    "@types/node": "22.20.7",
    "supabase": "2.117.0",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "supabase"
    ]
  }
}
