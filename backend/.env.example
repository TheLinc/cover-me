# Copy to backend/.env (gitignored). The Supabase CLI reads it on `pnpm start`, and any
# SUPABASE_<section>_<key> variable overrides that key in supabase/config.toml.

# Google sign-in on the local stack (README → Local backend). Use a separate Google OAuth
# client of type "Web application" with this authorized redirect URI:
#   http://127.0.0.1:54321/auth/v1/callback
# (no JavaScript origin needed: Supabase uses the server-side code flow). Then `pnpm stop`,
# `pnpm start` and `pnpm env:local` (which turns on the Google buttons in the local builds).
SUPABASE_AUTH_EXTERNAL_GOOGLE_ENABLED=false
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
